# Скопируйте в .env и заполните значения

# Ключ для /execute (пустой = открытый доступ)
API_KEY=

# Ключ обхода rate limit через заголовок x-admin-key (пустой = обход недоступен)
ADMIN_KEY=

# Ключ для /restart (пустой = без авторизации)
RESTART_TOKEN=

# Таймаут выполнения кода в секундах
TIMEOUT=60

# LLM для объяснения ошибок (опционально)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
